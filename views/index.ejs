<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Toyota - Website Quản Lý Sản Phẩm Ô Tô</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/style.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .hero-gradient { background: linear-gradient(135deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%); }
  </style>
</head>
<body class="bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-4">
      <nav class="flex items-center justify-between py-4">
        <a href="/" class="flex items-center space-x-3">
          <div class="bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-xl">TOYOTA</div>
        </a>
        <ul class="hidden md:flex space-x-8 items-center">
          <li><a href="/" class="text-gray-700 hover:text-red-600 font-medium">Trang chủ</a></li>
          <li><a href="/san-pham" class="text-gray-700 hover:text-red-600 font-medium">Sản phẩm</a></li>
          <li><a href="/tin-tuc" class="text-gray-700 hover:text-red-600 font-medium">Tin tức</a></li>
          <li><a href="/khuyen-mai" class="text-gray-700 hover:text-red-600 font-medium">Khuyến mãi</a></li>
          <li><a href="/dang-ky-lai-thu" class="text-gray-700 hover:text-red-600 font-medium">Đăng ký lái thử</a></li>
          <li><a href="/tra-gop" class="text-gray-700 hover:text-red-600 font-medium">Trả góp</a></li>
          <li><a href="/lien-he" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 font-medium">Liên hệ</a></li>
        </ul>
        <button id="menuBtn" class="md:hidden text-gray-700 focus:outline-none" onclick="toggleMenu()" aria-label="Menu">
          <svg id="menuIconOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menuIconClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </nav>
      <!-- Mobile Menu -->
      <div id="mobileMenu" class="md:hidden hidden pb-4">
        <ul class="flex flex-col space-y-1">
          <li><a href="/" class="block px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 font-medium rounded-lg">Trang chủ</a></li>
          <li><a href="/san-pham" class="block px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 font-medium rounded-lg">Sản phẩm</a></li>
          <li><a href="/tin-tuc" class="block px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 font-medium rounded-lg">Tin tức</a></li>
          <li><a href="/khuyen-mai" class="block px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 font-medium rounded-lg">Khuyến mãi</a></li>
          <li><a href="/dang-ky-lai-thu" class="block px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 font-medium rounded-lg">Đăng ký lái thử</a></li>
          <li><a href="/tra-gop" class="block px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 font-medium rounded-lg">Trả góp</a></li>
          <li><a href="/lien-he" class="block mx-4 mt-2 bg-red-600 text-white text-center px-6 py-3 rounded-lg hover:bg-red-700 font-medium">Liên hệ</a></li>
        </ul>
      </div>
    </div>
  </header>

  <!-- Hero Banner Slider -->
  <% if (banners && banners.length > 0) { %>
  <section class="relative bg-gray-900 overflow-hidden">
    <div class="banner-slider relative" style="height: 600px;">
      <% banners.forEach((banner, index) => { %>
      <div class="banner-slide <%= index === 0 ? 'active' : '' %> absolute inset-0 transition-opacity duration-1000" style="opacity: <%= index === 0 ? '1' : '0' %>">
        <img src="<%= banner %>" alt="Banner <%= index + 1 %>" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-b from-black/20 to-black/40"></div>
      </div>
      <% }); %>

      <!-- Navigation Arrows -->
      <% if (banners.length > 1) { %>
      <button onclick="prevSlide()" class="absolute left-8 top-1/2 -translate-y-1/2 z-20 bg-white/30 hover:bg-white/60 text-white p-4 rounded-full backdrop-blur-sm transition">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button onclick="nextSlide()" class="absolute right-8 top-1/2 -translate-y-1/2 z-20 bg-white/30 hover:bg-white/60 text-white p-4 rounded-full backdrop-blur-sm transition">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
      <% } %>

      <!-- Dots Indicator - Bottom Center -->
      <% if (banners.length > 1) { %>
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3">
        <% banners.forEach((banner, index) => { %>
        <button onclick="goToSlide(<%= index %>)" class="banner-dot rounded-full transition-all duration-300 <%= index === 0 ? 'bg-white w-10 h-3' : 'bg-white/50 hover:bg-white/80 w-3 h-3' %>" data-index="<%= index %>"></button>
        <% }); %>
      </div>
      <% } %>
    </div>
  </section>
  <% } else { %>
  <!-- Fallback Hero if no banners -->
  <section class="hero-gradient text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">TOYOTA</h1>
      <p class="text-xl md:text-2xl mb-8">Luôn Tốt Hơn Mỗi Ngày</p>
    </div>
  </section>
  <% } %>

  <!-- CTA Buttons Below Banner -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col sm:flex-row gap-6 justify-center max-w-2xl mx-auto">
        <a href="/san-pham" class="flex-1 bg-red-600 text-white text-center px-8 py-4 rounded-lg font-bold text-lg hover:bg-red-700 transition shadow-lg">
          🚗 Xem Sản Phẩm
        </a>
        <a href="/dang-ky-lai-thu" class="flex-1 bg-gray-900 text-white text-center px-8 py-4 rounded-lg font-bold text-lg hover:bg-gray-800 transition shadow-lg">
          🔑 Đăng Ký Lái Thử
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Cars -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">Sản Phẩm Nổi Bật</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <% featuredCars.forEach(car => { %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden card-hover">
          <div class="h-48 bg-gray-200 flex items-center justify-center">
            <img src="<%= car.image %>" alt="<%= car.name %>" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<span class=text-gray-400>📷 <%= car.name %></span>'">
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2"><%= car.name %></h3>
            <p class="text-gray-600 text-sm mb-4"><%= car.tagline %></p>
            <p class="text-red-600 text-2xl font-bold mb-4"><%= car.priceRange %></p>
            <a href="/san-pham/<%= car.slug %>" class="block w-full bg-red-600 text-white text-center py-3 rounded-lg font-semibold hover:bg-red-700 transition">Xem Chi Tiết</a>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Promotions -->
  <% if (activePromotions && activePromotions.length > 0) { %>
  <section class="py-16 bg-gray-100">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">Khuyến Mãi Đặc Biệt</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <% activePromotions.forEach(promo => { %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden card-hover">
          <div class="h-64 bg-gradient-to-br from-red-500 to-orange-500 flex items-center justify-center text-white text-6xl">
            🎁
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-900 mb-2"><%= promo.title %></h3>
            <p class="text-gray-600 mb-4"><%= promo.description %></p>
            <div class="mb-4">
              <% promo.details.slice(0, 3).forEach(detail => { %>
              <p class="text-sm text-gray-700 mb-2">✓ <%= detail %></p>
              <% }); %>
            </div>
            <a href="/khuyen-mai" class="inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">Xem Chi Tiết</a>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Latest News -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">Tin Tức Mới Nhất</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% latestNews.forEach(article => { %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden card-hover">
          <div class="h-48 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-400 text-4xl">📰</span>
          </div>
          <div class="p-6">
            <span class="inline-block bg-red-100 text-red-600 px-3 py-1 rounded-full text-xs font-semibold mb-3"><%= article.category %></span>
            <h3 class="text-lg font-bold text-gray-900 mb-2"><%= article.title %></h3>
            <p class="text-gray-600 text-sm mb-4"><%= article.summary %></p>
            <div class="flex justify-between items-center">
              <span class="text-gray-400 text-xs"><%= article.date %></span>
              <a href="/tin-tuc/<%= article.id %>" class="text-red-600 font-semibold hover:underline">Đọc thêm →</a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-red-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Sẵn Sàng Trải Nghiệm?</h2>
      <p class="text-xl mb-8">Đăng ký lái thử ngay hôm nay hoặc liên hệ để được tư vấn</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/dang-ky-lai-thu" class="bg-white text-red-600 px-8 py-4 rounded-lg font-bold hover:bg-gray-100 transition">Đăng Ký Lái Thử</a>
        <a href="/lien-he" class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-lg font-bold hover:bg-white hover:text-red-600 transition">Liên Hệ Ngay</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-8">
    <div class="container mx-auto px-4 text-center text-gray-400">
      <p>&copy; 2024 Toyota. All rights reserved.</p>
    </div>
  </footer>

  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.banner-slide');
    const dots = document.querySelectorAll('.banner-dot');
    const totalSlides = slides.length;

    function showSlide(index) {
      if (totalSlides === 0) return;
      
      currentSlide = (index + totalSlides) % totalSlides;
      
      slides.forEach((slide, i) => {
        slide.style.opacity = i === currentSlide ? '1' : '0';
        slide.style.zIndex = i === currentSlide ? '1' : '0';
      });
      
      dots.forEach((dot, i) => {
        if (i === currentSlide) {
          dot.classList.add('bg-white', 'w-10', 'h-3');
          dot.classList.remove('bg-white/50', 'w-3');
        } else {
          dot.classList.remove('bg-white', 'w-10', 'h-3');
          dot.classList.add('bg-white/50', 'w-3');
        }
      });
    }

    function nextSlide() {
      showSlide(currentSlide + 1);
    }

    function prevSlide() {
      showSlide(currentSlide - 1);
    }

    function goToSlide(index) {
      showSlide(index);
    }

    // Auto play
    if (totalSlides > 1) {
      setInterval(() => {
        nextSlide();
      }, 5000);
    }

    function toggleMenu() {
      const menu = document.getElementById('mobileMenu');
      const iconOpen = document.getElementById('menuIconOpen');
      const iconClose = document.getElementById('menuIconClose');
      const isHidden = menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !isHidden);
      iconOpen.classList.toggle('hidden', isHidden);
      iconClose.classList.toggle('hidden', !isHidden);
    }
  </script>
</body>
</html>

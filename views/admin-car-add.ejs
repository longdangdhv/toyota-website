<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm xe mới - Toyota Admin</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
        }
        .header {
            background: #eb0a1e;
            color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .header h1 {
            font-size: 24px;
        }
        .btn-logout {
            padding: 8px 16px;
            background: rgba(255,255,255,0.2);
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }
        .container {
            max-width: 900px;
            margin: 30px auto;
            padding: 0 20px;
        }
        .breadcrumb {
            margin-bottom: 20px;
            color: #666;
        }
        .breadcrumb a {
            color: #eb0a1e;
            text-decoration: none;
        }
        .content {
            background: white;
            border-radius: 8px;
            padding: 30px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        h2 {
            color: #333;
            margin-bottom: 25px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 500;
        }
        input[type="text"],
        input[type="number"],
        textarea,
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
            font-family: inherit;
        }
        textarea {
            min-height: 100px;
            resize: vertical;
        }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .checkbox-group input[type="checkbox"] {
            width: auto;
        }
        .btn-group {
            display: flex;
            gap: 10px;
            margin-top: 30px;
        }
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
        }
        .btn-primary {
            background: #eb0a1e;
            color: white;
        }
        .btn-primary:hover {
            background: #c41230;
        }
        .btn-secondary {
            background: #6c757d;
            color: white;
        }
        .btn-secondary:hover {
            background: #5a6268;
        }
        .preview-image {
            max-width: 300px;
            margin-top: 10px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .image-options {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }
        .image-option {
            flex: 1;
        }
        .image-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 10px;
            margin-top: 10px;
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 5px;
        }
        .gallery-item {
            cursor: pointer;
            border: 2px solid transparent;
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.3s;
        }
        .gallery-item:hover {
            border-color: #eb0a1e;
            transform: scale(1.05);
        }
        .gallery-item.selected {
            border-color: #eb0a1e;
            box-shadow: 0 0 10px rgba(235, 10, 30, 0.5);
        }
        .gallery-item img {
            width: 100%;
            height: 80px;
            object-fit: cover;
            display: block;
        }
        .gallery-item-name {
            font-size: 10px;
            padding: 5px;
            background: #f9f9f9;
            text-align: center;
            word-break: break-all;
        }
        .upload-method {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }
        .upload-method label {
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            padding: 10px 15px;
            border: 2px solid #ddd;
            border-radius: 5px;
            background: white;
            transition: all 0.3s;
        }
        .upload-method input[type="radio"]:checked + label {
            border-color: #eb0a1e;
            background: #fff5f5;
        }
        .upload-method input[type="radio"] {
            display: none;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🚗 TOYOTA Admin</h1>
        <a href="/admin/logout" class="btn-logout">Đăng xuất</a>
    </div>
    
    <div class="container">
        <div class="breadcrumb">
            <a href="/admin">Dashboard</a> / 
            <a href="/admin/cars">Quản lý xe</a> / 
            <strong>Thêm xe mới</strong>
        </div>
        
        <div class="content">
            <h2>➕ Thêm xe mới</h2>
            
            <form method="POST" action="/admin/cars/add" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="name">Tên xe *</label>
                    <input type="text" id="name" name="name" required>
                </div>
                
                <div class="form-group">
                    <label for="slug">Slug (URL) *</label>
                    <input type="text" id="slug" name="slug" required>
                    <small style="color: #666;">Ví dụ: camry-2024 (không dấu, viết thường, dùng gạch ngang)</small>
                </div>
                
                <div class="form-group">
                    <label for="tagline">Tagline</label>
                    <input type="text" id="tagline" name="tagline" placeholder="Slogan của xe">
                </div>
                
                <div class="form-group">
                    <label for="price">Giá</label>
                    <input type="text" id="price" name="price" placeholder="Ví dụ: 1,070,000,000đ">
                </div>
                
                <div class="form-group">
                    <label for="priceRange">Khoảng giá</label>
                    <input type="text" id="priceRange" name="priceRange" placeholder="Ví dụ: 1.07 - 1.43 tỷ">
                </div>
                
                <div class="form-group">
                    <label for="category">Danh mục *</label>
                    <select id="category" name="category" required>
                        <option value="">-- Chọn danh mục --</option>
                        <option value="Sedan">Sedan</option>
                        <option value="SUV">SUV</option>
                        <option value="MPV">MPV</option>
                        <option value="Bán tải">Bán tải</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="image">Ảnh xe</label>
                    
                    <div class="upload-method">
                        <input type="radio" name="uploadMethod" id="method-select" value="select" checked>
                        <label for="method-select">📁 Chọn ảnh có sẵn</label>
                        
                        <input type="radio" name="uploadMethod" id="method-upload" value="upload">
                        <label for="method-upload">📤 Upload ảnh mới</label>
                        
                        <input type="radio" name="uploadMethod" id="method-url" value="url">
                        <label for="method-url">🔗 Nhập URL</label>
                    </div>
                    
                    <div id="select-section">
                        <p style="color: #666; margin-bottom: 10px;">Click vào ảnh để chọn:</p>
                        <div class="image-gallery">
                            <% availableImages.forEach(img => { %>
                                <div class="gallery-item" onclick="selectImage('<%= img.path %>', this)" data-path="<%= img.path %>">
                                    <img src="<%= img.path %>" alt="<%= img.name %>">
                                    <div class="gallery-item-name"><%= img.name %></div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    
                    <div id="upload-section" style="display: none;">
                        <input type="file" id="imageFile" name="imageFile" accept="image/jpeg,image/png" onchange="handleFileSelect(this)">
                    </div>
                    
                    <div id="url-section" style="display: none;">
                        <input type="text" id="imageUrl" placeholder="/images/ten-anh.jpg" onchange="handleUrlInput(this.value)">
                    </div>
                    
                    <input type="hidden" id="image" name="image" value="">
                    
                    <div style="margin-top: 15px;">
                        <strong>Preview:</strong>
                        <img id="preview" src="" alt="Preview" class="preview-image" style="display: none;">
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="description">Mô tả</label>
                    <textarea id="description" name="description" placeholder="Mô tả chi tiết về xe"></textarea>
                </div>
                
                <div class="form-group checkbox-group">
                    <input type="checkbox" id="featured" name="featured">
                    <label for="featured" style="margin: 0;">Đánh dấu là xe nổi bật</label>
                </div>
                
                <div class="btn-group">
                    <button type="submit" class="btn btn-primary">💾 Thêm xe</button>
                    <a href="/admin/cars" class="btn btn-secondary">❌ Hủy</a>
                </div>
            </form>
        </div>
    </div>
    
    <script>
        // Chuyển đổi phương thức upload
        document.querySelectorAll('input[name="uploadMethod"]').forEach(radio => {
            radio.addEventListener('change', function() {
                document.getElementById('select-section').style.display = 'none';
                document.getElementById('upload-section').style.display = 'none';
                document.getElementById('url-section').style.display = 'none';
                
                if (this.value === 'select') {
                    document.getElementById('select-section').style.display = 'block';
                } else if (this.value === 'upload') {
                    document.getElementById('upload-section').style.display = 'block';
                } else if (this.value === 'url') {
                    document.getElementById('url-section').style.display = 'block';
                }
            });
        });
        
        // Chọn ảnh từ gallery
        function selectImage(path, element) {
            document.querySelectorAll('.gallery-item').forEach(item => {
                item.classList.remove('selected');
            });
            element.classList.add('selected');
            document.getElementById('image').value = path;
            previewImage(path);
        }
        
        // Xử lý upload file mới
        function handleFileSelect(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage(e.target.result);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
        
        // Preview ảnh
        function previewImage(url) {
            const preview = document.getElementById('preview');
            preview.src = url;
            preview.style.display = 'block';
        }
        
        // Xử lý nhập URL
        function handleUrlInput(url) {
            document.getElementById('image').value = url;
            previewImage(url);
        }
        
        // Auto generate slug
        document.getElementById('name').addEventListener('input', function() {
            const slug = this.value
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/[^a-z0-9\s-]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-')
                .trim();
            document.getElementById('slug').value = slug;
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sửa xe - Toyota Admin</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
        }
        .header {
            background: #eb0a1e;
            color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .header h1 {
            font-size: 24px;
        }
        .btn-logout {
            padding: 8px 16px;
            background: rgba(255,255,255,0.2);
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }
        .container {
            max-width: 900px;
            margin: 30px auto;
            padding: 0 20px;
        }
        .breadcrumb {
            margin-bottom: 20px;
            color: #666;
        }
        .breadcrumb a {
            color: #eb0a1e;
            text-decoration: none;
        }
        .content {
            background: white;
            border-radius: 8px;
            padding: 30px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        h2 {
            color: #333;
            margin-bottom: 25px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 500;
        }
        input[type="text"],
        input[type="number"],
        textarea,
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
            font-family: inherit;
        }
        textarea {
            min-height: 100px;
            resize: vertical;
        }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .checkbox-group input[type="checkbox"] {
            width: auto;
        }
        .btn-group {
            display: flex;
            gap: 10px;
            margin-top: 30px;
        }
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
        }
        .btn-primary {
            background: #eb0a1e;
            color: white;
        }
        .btn-primary:hover {
            background: #c41230;
        }
        .btn-secondary {
            background: #6c757d;
            color: white;
        }
        .btn-secondary:hover {
            background: #5a6268;
        }
        .preview-image {
            max-width: 300px;
            margin-top: 10px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .image-options {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }
        .image-option {
            flex: 1;
        }
        .image-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 10px;
            margin-top: 10px;
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 5px;
        }
        .gallery-item {
            cursor: pointer;
            border: 2px solid transparent;
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.3s;
        }
        .gallery-item:hover {
            border-color: #eb0a1e;
            transform: scale(1.05);
        }
        .gallery-item.selected {
            border-color: #eb0a1e;
            box-shadow: 0 0 10px rgba(235, 10, 30, 0.5);
            position: relative;
        }
        .gallery-item.selected::after {
            content: '✓';
            position: absolute;
            top: 5px;
            right: 5px;
            background: #eb0a1e;
            color: white;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
        }
        .gallery-item.main-image {
            border-color: #fbbf24;
            box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
        }
        .gallery-item.main-image::before {
            content: '⭐';
            position: absolute;
            top: 5px;
            left: 5px;
            background: #fbbf24;
            color: white;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }
        .selected-image-item {
            position: relative;
            width: 100px;
            height: 80px;
            border: 2px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            cursor: pointer;
        }
        .selected-image-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .selected-image-item .remove-btn {
            position: absolute;
            top: 3px;
            right: 3px;
            background: rgba(235, 10, 30, 0.9);
            color: white;
            border: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .selected-image-item .main-badge {
            position: absolute;
            bottom: 3px;
            left: 3px;
            background: rgba(251, 191, 36, 0.95);
            color: white;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
        }
        .selected-image-item:hover {
            border-color: #eb0a1e;
        }
        .gallery-item img {
            width: 100%;
            height: 80px;
            object-fit: cover;
            display: block;
        }
        .gallery-item-name {
            font-size: 10px;
            padding: 5px;
            background: #f9f9f9;
            text-align: center;
            word-break: break-all;
        }
        .upload-method {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }
        .upload-method label {
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            padding: 10px 15px;
            border: 2px solid #ddd;
            border-radius: 5px;
            background: white;
            transition: all 0.3s;
        }
        .upload-method input[type="radio"]:checked + label {
            border-color: #eb0a1e;
            background: #fff5f5;
        }
        .upload-method input[type="radio"] {
            display: none;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🚗 TOYOTA Admin</h1>
        <a href="/admin/logout" class="btn-logout">Đăng xuất</a>
    </div>
    
    <div class="container">
        <div class="breadcrumb">
            <a href="/admin">Dashboard</a> / 
            <a href="/admin/cars">Quản lý xe</a> / 
            <strong>Sửa xe</strong>
        </div>
        
        <div class="content">
            <h2>Sửa thông tin xe: <%= car.name %></h2>
            
            <form method="POST" action="/admin/cars/update/<%= car.id %>" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="name">Tên xe *</label>
                    <input type="text" id="name" name="name" value="<%= car.name %>" required>
                </div>
                
                <div class="form-group">
                    <label for="slug">Slug (URL) *</label>
                    <input type="text" id="slug" name="slug" value="<%= car.slug %>" required>
                </div>
                
                <div class="form-group">
                    <label for="tagline">Tagline</label>
                    <input type="text" id="tagline" name="tagline" value="<%= car.tagline %>">
                </div>
                
                <div class="form-group">
                    <label for="price">Giá</label>
                    <input type="text" id="price" name="price" value="<%= car.price %>">
                </div>
                
                <div class="form-group">
                    <label for="priceRange">Khoảng giá</label>
                    <input type="text" id="priceRange" name="priceRange" value="<%= car.priceRange %>">
                </div>
                
                <div class="form-group">
                    <label for="category">Danh mục *</label>
                    <select id="category" name="category" required>
                        <option value="Sedan" <%= car.category === 'Sedan' ? 'selected' : '' %>>Sedan</option>
                        <option value="SUV" <%= car.category === 'SUV' ? 'selected' : '' %>>SUV</option>
                        <option value="MPV" <%= car.category === 'MPV' ? 'selected' : '' %>>MPV</option>
                        <option value="Bán tải" <%= car.category === 'Bán tải' ? 'selected' : '' %>>Bán tải</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="image">🖼️ Quản lý ảnh xe</label>
                    
                    <div style="background: #f9f9f9; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                        <h4 style="margin-bottom: 10px; color: #333;">📸 Ảnh đã chọn (<span id="imageCount">0</span>)</h4>
                        <div id="selectedImages" style="display: flex; flex-wrap: wrap; gap: 10px; min-height: 50px;">
                            <p style="color: #999;">Chưa có ảnh nào được chọn</p>
                        </div>
                    </div>
                    
                    <div class="upload-method">
                        <input type="radio" name="uploadMethod" id="method-select" value="select" checked>
                        <label for="method-select">📁 Chọn từ thư viện</label>
                        
                        <input type="radio" name="uploadMethod" id="method-upload" value="upload">
                        <label for="method-upload">📤 Upload ảnh mới</label>
                    </div>
                    
                    <div id="select-section">
                        <p style="color: #666; margin-bottom: 10px;">Click để thêm ảnh (có thể chọn nhiều ảnh):</p>
                        <div class="image-gallery">
                            <% availableImages.forEach(img => { %>
                                <div class="gallery-item" onclick="toggleImage('<%= img.path %>', this)" data-path="<%= img.path %>">
                                    <img src="<%= img.path %>" alt="<%= img.name %>">
                                    <div class="gallery-item-name"><%= img.name %></div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    
                    <div id="upload-section" style="display: none;">
                        <input type="file" id="imageFiles" name="imageFiles" multiple accept="image/jpeg,image/png" onchange="handleMultiFileSelect(this)">
                        <small style="color: #666; display: block; margin-top: 5px;">Có thể chọn nhiều file cùng lúc (Ctrl + Click)</small>
                    </div>
                    
                    <input type="hidden" id="images" name="images" value="">
                    <input type="hidden" id="mainImage" name="mainImage" value="">
                </div>
                
                <div class="form-group">
                    <label for="description">Mô tả (Bài viết về xe)</label>
                    <textarea id="description" name="description"><%= car.description %></textarea>
                    <small style="color: #666; display: block; margin-top: 5px;">✍️ Soạn thảo văn bản với đầy đủ định dạng: căn lề, tiêu đề, chèn ảnh, bảng...</small>
                </div>
                
                <div class="form-group checkbox-group">
                    <input type="checkbox" id="featured" name="featured" <%= car.featured ? 'checked' : '' %>>
                    <label for="featured" style="margin: 0;">Đánh dấu là xe nổi bật</label>
                </div>
                
                <div class="btn-group">
                    <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
                    <a href="/admin/cars" class="btn btn-secondary">❌ Hủy</a>
                </div>
            </form>
        </div>
    </div>
    
    <!-- TinyMCE CDN -->
    <script src="https://cdn.tiny.cloud/1/2etkuqtd0naftcgirq6ue0s3lbyentl2eoyj5uabubm7oq9t/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '#description',
            language: 'vi',
            language_url: 'https://cdn.jsdelivr.net/npm/tinymce-lang-vi@1.0.1/langs/vi.js',
            height: 450,
            menubar: true,
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
                'insertdatetime', 'media', 'table', 'wordcount', 'emoticons'
            ],
            toolbar: 'undo redo | styles | bold italic underline strikethrough | ' +
                     'alignleft aligncenter alignright alignjustify | ' +
                     'bullist numlist outdent indent | link image media table | ' +
                     'forecolor backcolor | removeformat | fullscreen code',
            toolbar_mode: 'wrap',
            image_title: true,
            automatic_uploads: true,
            file_picker_types: 'image',
            file_picker_callback: function(cb, value, meta) {
                var input = document.createElement('input');
                input.setAttribute('type', 'file');
                input.setAttribute('accept', 'image/*');
                input.onchange = function() {
                    var file = this.files[0];
                    var reader = new FileReader();
                    reader.onload = function() {
                        var id = 'blobid' + (new Date()).getTime();
                        var blobCache = tinymce.activeEditor.editorUpload.blobCache;
                        var base64 = reader.result.split(',')[1];
                        var blobInfo = blobCache.create(id, file, base64);
                        blobCache.add(blobInfo);
                        cb(blobInfo.blobUri(), { title: file.name });
                    };
                    reader.readAsDataURL(file);
                };
                input.click();
            },
            content_style: 'body { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; font-size: 15px; line-height: 1.7; color: #333; }',
            style_formats: [
                { title: 'Tiêu đề lớn', format: 'h2' },
                { title: 'Tiêu đề vừa', format: 'h3' },
                { title: 'Tiêu đề nhỏ', format: 'h4' },
                { title: 'Đoạn văn', format: 'p' },
                { title: 'Trích dẫn', block: 'blockquote' }
            ],
            setup: function(editor) {
                editor.on('change', function() {
                    editor.save();
                });
            }
        });
    </script>
    <script>
        // Mảng lưu các ảnh đã chọn
        let selectedImagesList = [];
        let mainImagePath = '';
        
        // Khởi tạo ảnh hiện có
        window.addEventListener('DOMContentLoaded', function() {
            // Parse images từ server
            <% if (car.images && Array.isArray(car.images) && car.images.length > 0) { %>
                selectedImagesList = <%- JSON.stringify(car.images) %>;
            <% } else if (car.image) { %>
                selectedImagesList = <%- JSON.stringify([car.image]) %>;
            <% } %>
            
            mainImagePath = <%- JSON.stringify(car.image || '') %>;

            console.log('🔍 Loaded images:', selectedImagesList);
            console.log('⭐ Main image:', mainImagePath);
            
            if (selectedImagesList.length > 0) {
                updateSelectedImagesDisplay();
                highlightSelectedInGallery();
                updateHiddenInputs();
            }
        });
        
        // Chuyển đổi phương thức upload
        document.querySelectorAll('input[name="uploadMethod"]').forEach(radio => {
            radio.addEventListener('change', function() {
                document.getElementById('select-section').style.display = 'none';
                document.getElementById('upload-section').style.display = 'none';
                
                if (this.value === 'select') {
                    document.getElementById('select-section').style.display = 'block';
                } else if (this.value === 'upload') {
                    document.getElementById('upload-section').style.display = 'block';
                }
            });
        });
        
        // Chọn/bỏ chọn ảnh từ gallery
        function toggleImage(path, element) {
            const index = selectedImagesList.indexOf(path);
            
            if (index > -1) {
                // Nếu đang là ảnh đại diện, không cho xóa
                if (path === mainImagePath && selectedImagesList.length > 1) {
                    alert('Không thể xóa ảnh đại diện! Hãy chọn ảnh khác làm đại diện trước.');
                    return;
                }
                // Xóa khỏi danh sách
                selectedImagesList.splice(index, 1);
                element.classList.remove('selected', 'main-image');
                
                // Nếu xóa ảnh đại diện, chọn ảnh đầu tiên làm đại diện
                if (path === mainImagePath && selectedImagesList.length > 0) {
                    mainImagePath = selectedImagesList[0];
                }
            } else {
                // Thêm vào danh sách
                selectedImagesList.push(path);
                element.classList.add('selected');
                
                // Nếu là ảnh đầu tiên, tự động làm ảnh đại diện
                if (selectedImagesList.length === 1) {
                    mainImagePath = path;
                    element.classList.add('main-image');
                }
            }
            
            updateSelectedImagesDisplay();
            updateHiddenInputs();
        }
        
        // Hiển thị danh sách ảnh đã chọn
        function updateSelectedImagesDisplay() {
            const container = document.getElementById('selectedImages');
            const countEl = document.getElementById('imageCount');
            
            console.log('📊 Updating display. Count:', selectedImagesList.length);
            
            if (countEl) {
                countEl.textContent = selectedImagesList.length;
            }
            
            if (!container) {
                console.error('❌ Container #selectedImages not found');
                return;
            }
            
            if (selectedImagesList.length === 0) {
                container.innerHTML = '<p style="color: #999;">Chưa có ảnh nào được chọn</p>';
                return;
            }
            
            container.innerHTML = selectedImagesList.map(path => {
                const isMain = path === mainImagePath;
                const escapedPath = path.replace(/'/g, "\\'");
                return `
                    <div class="selected-image-item" onclick="setMainImage('${escapedPath}')" title="Click để đặt làm ảnh đại diện">
                        <img src="${path}" alt="Selected">
                        <button type="button" class="remove-btn" onclick="event.stopPropagation(); removeImage('${escapedPath}')">×</button>
                        ${isMain ? '<div class="main-badge">Đại diện</div>' : ''}
                    </div>
                `;
            }).join('');
            
            console.log('✅ Display updated');
        }
        
        // Đặt ảnh làm ảnh đại diện
        function setMainImage(path) {
            mainImagePath = path;
            updateSelectedImagesDisplay();
            updateHiddenInputs();
            highlightSelectedInGallery();
        }
        
        // Xóa ảnh khỏi danh sách
        function removeImage(path) {
            if (path === mainImagePath && selectedImagesList.length > 1) {
                alert('Không thể xóa ảnh đại diện! Hãy chọn ảnh khác làm đại diện trước.');
                return;
            }
            
            const index = selectedImagesList.indexOf(path);
            if (index > -1) {
                selectedImagesList.splice(index, 1);
                
                // Nếu xóa ảnh đại diện, chọn ảnh đầu tiên làm đại diện
                if (path === mainImagePath && selectedImagesList.length > 0) {
                    mainImagePath = selectedImagesList[0];
                } else if (selectedImagesList.length === 0) {
                    mainImagePath = '';
                }
                
                updateSelectedImagesDisplay();
                updateHiddenInputs();
                highlightSelectedInGallery();
            }
        }
        
        // Cập nhật hidden inputs
        function updateHiddenInputs() {
            const imagesInput = document.getElementById('images');
            const mainImageInput = document.getElementById('mainImage');
            
            if (imagesInput) {
                imagesInput.value = JSON.stringify(selectedImagesList);
                console.log('💾 Updated images count:', selectedImagesList.length);
            }
            
            if (mainImageInput) {
                mainImageInput.value = mainImagePath;
                console.log('⭐ Updated mainImage input');
            }
        }
        
        // Highlight ảnh đã chọn trong gallery
        function highlightSelectedInGallery() {
            document.querySelectorAll('.gallery-item').forEach(item => {
                const path = item.getAttribute('data-path');
                item.classList.remove('selected', 'main-image');
                
                if (selectedImagesList.includes(path)) {
                    item.classList.add('selected');
                    
                    if (path === mainImagePath) {
                        item.classList.add('main-image');
                    }
                }
            });
        }
        
        // Xử lý upload nhiều file
        function handleMultiFileSelect(input) {
            if (input.files && input.files.length > 0) {
                // Hiển thị preview cho các file đã chọn
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        // Tạm thời thêm vào danh sách với data URL
                        selectedImagesList.push(e.target.result);
                        if (selectedImagesList.length === 1) {
                            mainImagePath = e.target.result;
                        }
                        updateSelectedImagesDisplay();
                    };
                    reader.readAsDataURL(file);
                });
            }
        }
        
        // Debug function - Xem giá trị trước khi submit
        function debugFormData() {
            console.log('=== DEBUG FORM DATA ===');
            console.log('selectedImagesList:', selectedImagesList);
            console.log('mainImagePath:', mainImagePath);
            console.log('Hidden input #images value:', document.getElementById('images').value);
            console.log('Hidden input #mainImage value:', document.getElementById('mainImage').value);
            
            alert(
                'Số ảnh: ' + selectedImagesList.length + '\n' +
                'Ảnh đại diện: ' + mainImagePath + '\n\n' +
                'Hidden #images: ' + document.getElementById('images').value + '\n' +
                'Hidden #mainImage: ' + document.getElementById('mainImage').value + '\n\n' +
                'Xem Console (F12) để biết chi tiết'
            );
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= car.name %> - Toyota</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-4">
      <nav class="flex items-center justify-between py-4">
        <a href="/" class="flex items-center space-x-3">
          <div class="bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-xl">TOYOTA</div>
        </a>
        <ul class="hidden md:flex space-x-8 items-center">
          <li><a href="/" class="text-gray-700 hover:text-red-600 font-medium">Trang chủ</a></li>
          <li><a href="/san-pham" class="text-red-600 hover:text-red-600 font-medium">Sản phẩm</a></li>
          <li><a href="/tin-tuc" class="text-gray-700 hover:text-red-600 font-medium">Tin tức</a></li>
          <li><a href="/khuyen-mai" class="text-gray-700 hover:text-red-600 font-medium">Khuyến mãi</a></li>
          <li><a href="/dang-ky-lai-thu" class="text-gray-700 hover:text-red-600 font-medium">Đăng ký lái thử</a></li>
          <li><a href="/tra-gop" class="text-gray-700 hover:text-red-600 font-medium">Trả góp</a></li>
          <li><a href="/lien-he" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 font-medium">Liên hệ</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Breadcrumb -->
  <div class="bg-gray-100 py-4">
    <div class="container mx-auto px-4">
      <nav class="text-sm text-gray-600">
        <a href="/" class="hover:text-red-600">Trang chủ</a> / 
        <a href="/san-pham" class="hover:text-red-600">Sản phẩm</a> / 
        <span class="text-gray-900 font-semibold"><%= car.name %></span>
      </nav>
    </div>
  </div>

  <!-- Product Detail -->
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Image Gallery with Slider -->
        <div>
          <div class="bg-white rounded-2xl shadow-xl p-8">
            <!-- Main Image -->
            <div class="h-96 bg-gray-200 rounded-xl flex items-center justify-center mb-4 relative overflow-hidden">
              <% 
                let images = [];
                if (car.images && Array.isArray(car.images) && car.images.length > 0) {
                  // Lọc bỏ ảnh lỗi hoặc rỗng
                  images = car.images.filter(img => img && img.trim() !== '');
                } else if (car.image && car.image.trim() !== '') {
                  images = [car.image];
                }
                
                // Fallback nếu không có ảnh
                if (images.length === 0) {
                  images = ['/images/placeholder.jpg'];
                }
              %>
              <img id="mainImage" src="<%= images[0] %>" alt="<%= car.name %>" class="w-full h-full object-cover rounded-xl" onerror="this.parentElement.innerHTML='<span class=text-gray-400 text-9xl>🚗</span>'">
              
              <!-- Navigation Arrows -->
              <% if (images.length > 1) { %>
                <button onclick="previousImage()" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 rounded-full w-12 h-12 flex items-center justify-center shadow-lg transition">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </button>
                <button onclick="nextImage()" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 rounded-full w-12 h-12 flex items-center justify-center shadow-lg transition">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </button>
                
                <!-- Image Counter -->
                <div class="absolute bottom-4 right-4 bg-black/60 text-white px-3 py-1 rounded-full text-sm">
                  <span id="currentIndex">1</span> / <%= images.length %>
                </div>
              <% } %>
            </div>
            
            <!-- Thumbnails -->
            <% if (images.length > 1) { %>
              <div class="grid grid-cols-4 gap-2">
                <% images.forEach((img, index) => { %>
                  <div onclick="selectImage(<%= index %>)" class="cursor-pointer border-2 rounded-lg overflow-hidden hover:border-red-600 transition <%= index === 0 ? 'border-red-600' : 'border-gray-200' %>" id="thumb-<%= index %>">
                    <img src="<%= img %>" alt="Ảnh <%= index + 1 %>" class="w-full h-20 object-cover">
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
          
          <script>
            const images = <%- JSON.stringify(images) %>;
            let currentIndex = 0;
            
            function selectImage(index) {
              currentIndex = index;
              updateMainImage();
            }
            
            function previousImage() {
              currentIndex = (currentIndex - 1 + images.length) % images.length;
              updateMainImage();
            }
            
            function nextImage() {
              currentIndex = (currentIndex + 1) % images.length;
              updateMainImage();
            }
            
            function updateMainImage() {
              document.getElementById('mainImage').src = images[currentIndex];
              document.getElementById('currentIndex').textContent = currentIndex + 1;
              
              // Update thumbnail borders
              document.querySelectorAll('[id^="thumb-"]').forEach((thumb, index) => {
                if (index === currentIndex) {
                  thumb.classList.remove('border-gray-200');
                  thumb.classList.add('border-red-600');
                } else {
                  thumb.classList.add('border-gray-200');
                  thumb.classList.remove('border-red-600');
                }
              });
            }
            
            // Keyboard navigation
            document.addEventListener('keydown', (e) => {
              if (e.key === 'ArrowLeft') previousImage();
              if (e.key === 'ArrowRight') nextImage();
            });
          </script>
        </div>

        <!-- Info -->
        <div>
          <span class="inline-block bg-red-100 text-red-600 px-4 py-2 rounded-full text-sm font-semibold mb-4"><%= car.category %></span>
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4"><%= car.name %></h1>
          <p class="text-xl text-gray-600 mb-6"><%= car.tagline %></p>
          <div class="bg-red-50 border-l-4 border-red-600 p-6 mb-6">
            <p class="text-gray-700 text-lg font-semibold mb-2">Giá bán</p>
            <p class="text-red-600 text-4xl font-bold"><%= car.priceRange %></p>
          </div>

          <div class="mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Các phiên bản</h3>
            <div class="space-y-3">
              <% car.versions.forEach(version => { %>
              <div class="bg-white p-4 rounded-lg shadow flex justify-between items-center">
                <span class="font-semibold text-gray-900"><%= version.name %></span>
                <span class="text-red-600 font-bold"><%= parseInt(version.price).toLocaleString('vi-VN') %> VNĐ</span>
              </div>
              <% }); %>
            </div>
          </div>

          <div class="flex gap-4 mb-8">
            <button onclick="requestQuote()" class="flex-1 bg-red-600 text-white px-8 py-4 rounded-lg font-bold hover:bg-red-700 transition">Nhận Báo Giá</button>
            <a href="/dang-ky-lai-thu" class="flex-1 bg-gray-900 text-white px-8 py-4 rounded-lg font-bold hover:bg-gray-800 transition text-center">Đăng Ký Lái Thử</a>
          </div>
        </div>
      </div>

      <!-- Specifications -->
      <div class="mt-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Thông Số Kỹ Thuật</h2>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
          <div class="bg-white p-6 rounded-xl shadow text-center">
            <div class="text-4xl mb-3">⚙️</div>
            <p class="text-gray-600 text-sm mb-1">Động cơ</p>
            <p class="font-bold text-gray-900"><%= car.specs.engine %></p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow text-center">
            <div class="text-4xl mb-3">💪</div>
            <p class="text-gray-600 text-sm mb-1">Công suất</p>
            <p class="font-bold text-gray-900"><%= car.specs.power %></p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow text-center">
            <div class="text-4xl mb-3">⚡</div>
            <p class="text-gray-600 text-sm mb-1">Hộp số</p>
            <p class="font-bold text-gray-900"><%= car.specs.transmission %></p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow text-center">
            <div class="text-4xl mb-3">⛽</div>
            <p class="text-gray-600 text-sm mb-1">Tiêu hao</p>
            <p class="font-bold text-gray-900"><%= car.specs.fuelConsumption %></p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow text-center">
            <div class="text-4xl mb-3">👥</div>
            <p class="text-gray-600 text-sm mb-1">Số chỗ</p>
            <p class="font-bold text-gray-900"><%= car.specs.seats %> chỗ</p>
          </div>
        </div>
      </div>

      <!-- Features -->
      <div class="mt-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Tính Năng Nổi Bật</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% car.features.forEach(feature => { %>
          <div class="bg-white p-6 rounded-xl shadow">
            <div class="flex items-start space-x-3">
              <span class="text-green-500 text-2xl">✓</span>
              <p class="text-gray-700 font-medium"><%= feature %></p>
            </div>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- Colors -->
      <div class="mt-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Màu Sắc</h2>
        <div class="flex flex-wrap gap-4">
          <% car.colors.forEach(color => { %>
          <div class="bg-white px-6 py-3 rounded-lg shadow font-semibold text-gray-700"><%= color %></div>
          <% }); %>
        </div>
      </div>

      <!-- Description -->
      <div class="mt-16 bg-white p-8 rounded-2xl shadow-lg">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Mô Tả</h2>
        <p class="text-gray-700 text-lg leading-relaxed"><%= car.description %></p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-red-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Quan Tâm Đến <%= car.name %>?</h2>
      <p class="text-xl mb-8">Liên hệ ngay để được tư vấn và nhận ưu đãi tốt nhất</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button onclick="requestQuote()" class="bg-white text-red-600 px-8 py-4 rounded-lg font-bold hover:bg-gray-100 transition">Nhận Báo Giá Ngay</button>
        <a href="tel:0988888888" class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-lg font-bold hover:bg-white hover:text-red-600 transition text-center">Gọi: 098 888 8888</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-8">
    <div class="container mx-auto px-4 text-center text-gray-400">
      <p>&copy; 2024 Toyota. All rights reserved.</p>
    </div>
  </footer>

  <script>
    function filterCars(category) {
      // Filtering logic handled in products page
    }

    function requestQuote() {
      const name = prompt('Họ và tên của bạn:');
      if (!name) return;
      const phone = prompt('Số điện thoại:');
      if (!phone) return;
      
      fetch('/api/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, phone, car: '<%= car.name %>' })
      })
      .then(res => res.json())
      .then(data => {
        alert(data.message);
      })
      .catch(err => alert('Có lỗi xảy ra. Vui lòng thử lại!'));
    }
  </script>
</body>
</html>

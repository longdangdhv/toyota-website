<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.title %> - Toyota</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-4">
      <nav class="flex items-center justify-between py-4">
        <a href="/" class="flex items-center space-x-3">
          <div class="bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-xl">TOYOTA</div>
        </a>
        <ul class="hidden md:flex space-x-8 items-center">
          <li><a href="/" class="text-gray-700 hover:text-red-600 font-medium">Trang chủ</a></li>
          <li><a href="/san-pham" class="text-gray-700 hover:text-red-600 font-medium">Sản phẩm</a></li>
          <li><a href="/tin-tuc" class="text-red-600 hover:text-red-600 font-medium">Tin tức</a></li>
          <li><a href="/khuyen-mai" class="text-gray-700 hover:text-red-600 font-medium">Khuyến mãi</a></li>
          <li><a href="/dang-ky-lai-thu" class="text-gray-700 hover:text-red-600 font-medium">Đăng ký lái thử</a></li>
          <li><a href="/tra-gop" class="text-gray-700 hover:text-red-600 font-medium">Trả góp</a></li>
          <li><a href="/lien-he" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 font-medium">Liên hệ</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Breadcrumb -->
  <div class="bg-gray-100 py-4">
    <div class="container mx-auto px-4">
      <nav class="text-sm text-gray-600">
        <a href="/" class="hover:text-red-600">Trang chủ</a> / 
        <a href="/tin-tuc" class="hover:text-red-600">Tin tức</a> / 
        <span class="text-gray-900 font-semibold"><%= article.title %></span>
      </nav>
    </div>
  </div>

  <!-- Article -->
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <article class="bg-white rounded-2xl shadow-xl overflow-hidden">
          <!-- Featured Image -->
          <div class="h-96 bg-gradient-to-br from-red-500 to-orange-500 flex items-center justify-center text-white text-9xl">
            📰
          </div>

          <!-- Content -->
          <div class="p-8 md:p-12">
            <div class="flex items-center justify-between mb-6">
              <span class="inline-block bg-red-100 text-red-600 px-4 py-2 rounded-full text-sm font-semibold"><%= article.category %></span>
              <span class="text-gray-400"><%= article.date %></span>
            </div>

            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6"><%= article.title %></h1>
            
            <div class="prose prose-lg max-w-none">
              <p class="text-xl text-gray-600 mb-6 leading-relaxed"><%= article.summary %></p>
              <p class="text-gray-700 leading-relaxed"><%= article.content %></p>
            </div>

            <div class="mt-12 pt-8 border-t border-gray-200">
              <a href="/tin-tuc" class="inline-block bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition">← Quay lại Tin tức</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-8">
    <div class="container mx-auto px-4 text-center text-gray-400">
      <p>&copy; 2024 Toyota. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>

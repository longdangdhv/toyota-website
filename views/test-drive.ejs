<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng Ký Lái Thử - Toyota</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-4">
      <nav class="flex items-center justify-between py-4">
        <a href="/" class="flex items-center space-x-3">
          <div class="bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-xl">TOYOTA</div>
        </a>
        <ul class="hidden md:flex space-x-8 items-center">
          <li><a href="/" class="text-gray-700 hover:text-red-600 font-medium">Trang chủ</a></li>
          <li><a href="/san-pham" class="text-gray-700 hover:text-red-600 font-medium">Sản phẩm</a></li>
          <li><a href="/tin-tuc" class="text-gray-700 hover:text-red-600 font-medium">Tin tức</a></li>
          <li><a href="/khuyen-mai" class="text-gray-700 hover:text-red-600 font-medium">Khuyến mãi</a></li>
          <li><a href="/dang-ky-lai-thu" class="text-red-600 hover:text-red-600 font-medium border-b-2 border-red-600">Đăng ký lái thử</a></li>
          <li><a href="/tra-gop" class="text-gray-700 hover:text-red-600 font-medium">Trả góp</a></li>
          <li><a href="/lien-he" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 font-medium">Liên hệ</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="bg-gradient-to-r from-red-600 to-red-700 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Đăng Ký Lái Thử</h1>
      <p class="text-xl">Trải nghiệm xe Toyota ngay hôm nay - Miễn phí 100%</p>
    </div>
  </section>

  <!-- Form -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-8">Điền Thông Tin Đăng Ký</h2>
          <form id="testDriveForm" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Họ và tên *</label>
                <input type="text" name="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
              </div>
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Số điện thoại *</label>
                <input type="tel" name="phone" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
              </div>
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2">Email</label>
              <input type="email" name="email" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2">Chọn dòng xe muốn lái thử *</label>
              <select name="car" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
                <option value="">-- Chọn dòng xe --</option>
                <% cars.forEach(car => { %>
                <option value="<%= car.name %>"><%= car.name %> - <%= car.priceRange %></option>
                <% }); %>
              </select>
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2">Thời gian mong muốn</label>
              <input type="datetime-local" name="preferredTime" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2">Địa điểm lái thử</label>
              <select name="location" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent">
                <option value="showroom">Tại showroom</option>
                <option value="home">Tại nhà (trong nội thành Hà Nội)</option>
              </select>
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2">Ghi chú</label>
              <textarea name="note" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"></textarea>
            </div>

            <button type="submit" class="w-full bg-red-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-red-700 transition">
              Đăng Ký Ngay
            </button>
          </form>
        </div>

        <!-- Benefits -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
          <div class="bg-white p-6 rounded-xl shadow text-center">
            <div class="text-5xl mb-4">🚗</div>
            <h3 class="font-bold text-lg mb-2">Miễn Phí 100%</h3>
            <p class="text-gray-600">Không mất bất kỳ chi phí nào</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow text-center">
            <div class="text-5xl mb-4">⏱️</div>
            <h3 class="font-bold text-lg mb-2">Linh Hoạt Thời Gian</h3>
            <p class="text-gray-600">Chọn thời gian phù hợp với bạn</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow text-center">
            <div class="text-5xl mb-4">🎁</div>
            <h3 class="font-bold text-lg mb-2">Quà Tặng Hấp Dẫn</h3>
            <p class="text-gray-600">Nhận quà khi đăng ký lái thử</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-8">
    <div class="container mx-auto px-4 text-center text-gray-400">
      <p>&copy; 2024 Toyota. All rights reserved. | Hotline: 098 888 8888</p>
    </div>
  </footer>

  <script>
    // Notification function
    function showNotification(message, type = 'success') {
      const notification = document.createElement('div');
      notification.className = `fixed bottom-8 right-8 px-8 py-5 rounded-xl shadow-2xl transform transition-all duration-500 z-50 ${
        type === 'success' ? 'bg-green-500' : 'bg-red-500'
      } text-white font-semibold text-lg`;
      notification.style.opacity = '0';
      notification.style.transform = 'translateY(20px)';
      notification.style.minWidth = '320px';
      
      notification.innerHTML = `<span>${message}</span>`;
      
      document.body.appendChild(notification);
      
      // Animate in
      setTimeout(() => {
        notification.style.opacity = '1';
        notification.style.transform = 'translateY(0)';
      }, 10);
      
      // Animate out and remove after 5 seconds
      setTimeout(() => {
        notification.style.opacity = '0';
        notification.style.transform = 'translateY(20px)';
        setTimeout(() => notification.remove(), 500);
      }, 5000);
    }

    document.getElementById('testDriveForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      
      try {
        const response = await fetch('/api/test-drive', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
          showNotification(result.message, 'success');
          e.target.reset();
          
          // Redirect to home page after 5 seconds
          setTimeout(() => {
            window.location.href = '/';
          }, 5000);
        } else {
          showNotification(result.message, 'error');
        }
      } catch (error) {
        showNotification('Có lỗi xảy ra. Vui lòng thử lại!', 'error');
      }
    });
  </script>
</body>
</html>

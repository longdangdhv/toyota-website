<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Liên Hệ - Toyota</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-4">
      <nav class="flex items-center justify-between py-4">
        <a href="/" class="flex items-center space-x-3">
          <div class="bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-xl">TOYOTA</div>
        </a>
        <ul class="hidden md:flex space-x-8 items-center">
          <li><a href="/" class="text-gray-700 hover:text-red-600 font-medium">Trang chủ</a></li>
          <li><a href="/san-pham" class="text-gray-700 hover:text-red-600 font-medium">Sản phẩm</a></li>
          <li><a href="/tin-tuc" class="text-gray-700 hover:text-red-600 font-medium">Tin tức</a></li>
          <li><a href="/khuyen-mai" class="text-gray-700 hover:text-red-600 font-medium">Khuyến mãi</a></li>
          <li><a href="/dang-ky-lai-thu" class="text-gray-700 hover:text-red-600 font-medium">Đăng ký lái thử</a></li>
          <li><a href="/tra-gop" class="text-gray-700 hover:text-red-600 font-medium">Trả góp</a></li>
          <li><a href="/lien-he" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 font-medium">Liên hệ</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="bg-gradient-to-r from-red-600 to-red-700 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Liên Hệ Với Chúng Tôi</h1>
      <p class="text-xl">Chúng tôi luôn sẵn sàng hỗ trợ bạn</p>
    </div>
  </section>

  <!-- Contact Info & Form -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Contact Info -->
          <div>
            <h2 class="text-3xl font-bold text-gray-900 mb-8">Thông Tin Liên Hệ</h2>
            
            <div class="space-y-6">
              <% if (showroomInfo.address) { %>
              <div class="bg-white p-6 rounded-xl shadow-lg">
                <div class="flex items-start space-x-4">
                  <div class="text-4xl">📍</div>
                  <div>
                    <h3 class="font-bold text-lg mb-2">Địa chỉ Showroom</h3>
                    <p class="text-gray-600"><%= showroomInfo.address %></p>
                    <% if (showroomInfo.address2) { %>
                    <p class="text-gray-600 mt-1"><%= showroomInfo.address2 %></p>
                    <% } %>
                  </div>
                </div>
              </div>
              <% } %>

              <% if (showroomInfo.hotline) { %>
              <div class="bg-white p-6 rounded-xl shadow-lg">
                <div class="flex items-start space-x-4">
                  <div class="text-4xl">📞</div>
                  <div>
                    <h3 class="font-bold text-lg mb-2">Hotline</h3>
                    <p class="text-gray-600"><a href="tel:<%= showroomInfo.hotline.replace(/\s/g,'') %>" class="text-red-600 hover:underline text-xl font-bold"><%= showroomInfo.hotline %></a></p>
                    <% if (showroomInfo.hotline2) { %>
                    <p class="text-gray-600 mt-1"><a href="tel:<%= showroomInfo.hotline2.replace(/\s/g,'') %>" class="text-red-600 hover:underline text-lg font-semibold"><%= showroomInfo.hotline2 %></a></p>
                    <% } %>
                  </div>
                </div>
              </div>
              <% } %>

              <% if (showroomInfo.email) { %>
              <div class="bg-white p-6 rounded-xl shadow-lg">
                <div class="flex items-start space-x-4">
                  <div class="text-4xl">✉️</div>
                  <div>
                    <h3 class="font-bold text-lg mb-2">Email</h3>
                    <p class="text-gray-600"><a href="mailto:<%= showroomInfo.email %>" class="text-red-600 hover:underline"><%= showroomInfo.email %></a></p>
                    <% if (showroomInfo.email2) { %>
                    <p class="text-gray-600 mt-1"><a href="mailto:<%= showroomInfo.email2 %>" class="text-red-600 hover:underline"><%= showroomInfo.email2 %></a></p>
                    <% } %>
                  </div>
                </div>
              </div>
              <% } %>

              <% if (showroomInfo.working_hours) { %>
              <div class="bg-white p-6 rounded-xl shadow-lg">
                <div class="flex items-start space-x-4">
                  <div class="text-4xl">⏰</div>
                  <div>
                    <h3 class="font-bold text-lg mb-2">Giờ làm việc</h3>
                    <p class="text-gray-600"><%= showroomInfo.working_hours %></p>
                  </div>
                </div>
              </div>
              <% } %>

              <% if (showroomInfo.facebook_url || showroomInfo.zalo_url || showroomInfo.youtube_url) { %>
              <div class="bg-white p-6 rounded-xl shadow-lg">
                <div class="flex items-start space-x-4">
                  <div class="text-4xl">🌐</div>
                  <div>
                    <h3 class="font-bold text-lg mb-2">Mạng xã hội</h3>
                    <div class="flex gap-4 flex-wrap">
                      <% if (showroomInfo.facebook_url) { %>
                      <a href="<%= showroomInfo.facebook_url %>" target="_blank" class="text-blue-600 hover:underline font-medium">📘 Facebook</a>
                      <% } %>
                      <% if (showroomInfo.zalo_url) { %>
                      <a href="<%= showroomInfo.zalo_url %>" target="_blank" class="text-blue-400 hover:underline font-medium">💬 Zalo</a>
                      <% } %>
                      <% if (showroomInfo.youtube_url) { %>
                      <a href="<%= showroomInfo.youtube_url %>" target="_blank" class="text-red-600 hover:underline font-medium">▶️ YouTube</a>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
              <% } %>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="bg-white rounded-2xl shadow-xl p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Gửi Tin Nhắn</h2>
            <form id="contactForm" class="space-y-6">
              <div>
                <label class="block text-gray-700 font-semibold mb-2">Họ và tên *</label>
                <input type="text" name="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Số điện thoại *</label>
                <input type="tel" name="phone" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Email</label>
                <input type="email" name="email" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500">
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Chủ đề</label>
                <select name="subject" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500">
                  <option value="quote">Yêu cầu báo giá</option>
                  <option value="testdrive">Đăng ký lái thử</option>
                  <option value="service">Dịch vụ sau bán hàng</option>
                  <option value="other">Khác</option>
                </select>
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">Tin nhắn *</label>
                <textarea name="message" required rows="6" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500" placeholder="Nhập tin nhắn của bạn..."></textarea>
              </div>

              <button type="submit" class="w-full bg-red-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-red-700 transition">
                Gửi Tin Nhắn
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-8">
    <div class="container mx-auto px-4 text-center text-gray-400">
      <p>&copy; 2024 Toyota. All rights reserved.</p>
    </div>
  </footer>

  <script>
    // Notification function
    function showNotification(message, type = 'success') {
      const notification = document.createElement('div');
      notification.className = `fixed bottom-8 right-8 px-8 py-5 rounded-xl shadow-2xl transform transition-all duration-500 z-50 ${
        type === 'success' ? 'bg-green-500' : 'bg-red-500'
      } text-white font-semibold text-lg`;
      notification.style.opacity = '0';
      notification.style.transform = 'translateY(20px)';
      notification.style.minWidth = '320px';
      
      notification.innerHTML = `<span>${message}</span>`;
      
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.style.opacity = '1';
        notification.style.transform = 'translateY(0)';
      }, 10);
      
      setTimeout(() => {
        notification.style.opacity = '0';
        notification.style.transform = 'translateY(20px)';
        setTimeout(() => notification.remove(), 500);
      }, 5000);
    }


    document.getElementById('contactForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
          showNotification(result.message, 'success');
          e.target.reset();
          
          setTimeout(() => {
            window.location.href = '/';
          }, 5000);
        } else {
          showNotification(result.message, 'error');
        }
      } catch (error) {
        showNotification('Có lỗi xảy ra. Vui lòng thử lại!', 'error');
      }
    });
  </script>
</body>
</html>

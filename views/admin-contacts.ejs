<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý liên hệ - Toyota Admin</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f5f5f5; }
        .header { background: #eb0a1e; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .header h1 { font-size: 24px; }
        .btn-logout { padding: 8px 16px; background: rgba(255,255,255,0.2); color: white; text-decoration: none; border-radius: 5px; }
        .container { max-width: 1400px; margin: 30px auto; padding: 0 20px; }
        .breadcrumb { margin-bottom: 20px; color: #666; }
        .breadcrumb a { color: #eb0a1e; text-decoration: none; }
        .content { background: white; border-radius: 8px; padding: 30px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        h2 { color: #333; margin: 0; }
        .search-box { display: flex; gap: 10px; }
        .search-box input { padding: 10px; border: 1px solid #ddd; border-radius: 5px; width: 300px; font-size: 14px; }
        .search-box button { padding: 10px 20px; background: #eb0a1e; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; }
        .search-box button:hover { background: #c41230; }
        .stats { display: flex; gap: 20px; margin-bottom: 20px; padding: 15px; background: #f9f9f9; border-radius: 5px; }
        .stat-item { display: flex; align-items: center; gap: 8px; }
        .stat-item strong { color: #eb0a1e; font-size: 18px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        th { background: #f9f9f9; font-weight: 600; color: #333; }
        tr:hover { background: #f9f9f9; }
        .btn { display: inline-block; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 13px; transition: all 0.3s; border: none; cursor: pointer; }
        .btn-view { background: #007bff; color: white; }
        .btn-view:hover { background: #0056b3; }
        .btn-delete { background: #dc3545; color: white; margin-left: 5px; }
        .btn-delete:hover { background: #c82333; }
        .message-preview { max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .no-data { text-align: center; padding: 40px; color: #999; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; background: #28a745; color: white; }
    </style>
</head>
<body>
    <div class="header">
        <h1>🚗 TOYOTA Admin</h1>
        <a href="/admin/logout" class="btn-logout">Đăng xuất</a>
    </div>
    
    <div class="container">
        <div class="breadcrumb"><a href="/admin">Dashboard</a> / <strong>Quản lý liên hệ</strong></div>
        
        <div class="content">
            <div class="header-section">
                <h2>📧 Danh sách liên hệ từ khách hàng</h2>
                <div class="search-box">
                    <form action="/admin/contacts/search" method="GET" style="display: flex; gap: 10px;">
                        <input type="text" name="q" placeholder="Tìm kiếm theo tên, SĐT, email..." value="<%= typeof keyword !== 'undefined' ? keyword : '' %>">
                        <button type="submit">🔍 Tìm kiếm</button>
                    </form>
                </div>
            </div>
            
            <div class="stats">
                <div class="stat-item">
                    <span>Tổng số liên hệ:</span>
                    <strong><%= contacts.length %></strong>
                </div>
                <% if (typeof keyword !== 'undefined' && keyword) { %>
                    <div class="stat-item">
                        <span>Kết quả tìm kiếm cho "<%= keyword %>"</span>
                        <a href="/admin/contacts" style="margin-left: 10px; color: #eb0a1e;">✖ Xóa bộ lọc</a>
                    </div>
                <% } %>
            </div>
            
            <% if (contacts.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tên khách hàng</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Chủ đề</th>
                            <th>Tin nhắn</th>
                            <th>Thời gian</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% contacts.forEach(c => { %>
                            <tr>
                                <td><%= c.id %></td>
                                <td>
                                    <strong><%= c.name %></strong>
                                    <% if (!c.viewed) { %>
                                        <span class="badge">Mới</span>
                                    <% } %>
                                </td>
                                <td><a href="tel:<%= c.phone %>"><%= c.phone %></a></td>
                                <td><%= c.email ? '<a href="mailto:' + c.email + '">' + c.email + '</a>' : '-' %></td>
                                <td><%= c.subject || '-' %></td>
                                <td class="message-preview"><%= c.message %></td>
                                <td><%= new Date(c.created_at).toLocaleString('vi-VN') %></td>
                                <td style="white-space: nowrap;">
                                    <a href="/admin/contacts/view/<%= c.id %>" class="btn btn-view">👁 Xem</a>
                                    <form action="/admin/contacts/delete/<%= c.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn xóa tin nhắn này?')">
                                        <button type="submit" class="btn btn-delete">🗑 Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="no-data">
                    <% if (typeof keyword !== 'undefined' && keyword) { %>
                        ❌ Không tìm thấy kết quả nào cho "<%= keyword %>"
                    <% } else { %>
                        📭 Chưa có tin nhắn liên hệ nào từ khách hàng
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
